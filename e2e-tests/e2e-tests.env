# Locally this service runs with SPRING_PROFILES_ACTIVE=wallet-auth (services.yaml), whose
# app.auth.global-method-security.enabled defaults to true (application.yml) -- same as alpha/beta/prod.
# The test's own default assumes it's off (as it is for the no-auth/basic-auth profiles) and skips
# sending a Bearer token entirely, which the real profile's security filter chain rejects outright
# before this app's custom GA4GH-Search challenge logic ever runs.
E2E_GLOBAL_METHOD_SECURITY_ENABLED=true
