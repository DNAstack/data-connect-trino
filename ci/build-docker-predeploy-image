#!/usr/bin/env bash

function validate_arg() {
  local name=${1}
  local value=${2}

  if [ -z ${value} ]; then
    echo "Must specify value for ${name}." >&2
    exit 1
  else
    echo -n ${value}
  fi
}

set -ex

cd $(dirname $0)/..

# This script is invoked during CI build with the following arguments:
target_image_name=$(validate_arg "target image name" ${1})
app_name=$(validate_arg "app name" ${2})
app_version=$(validate_arg "app version" ${3})

# This script assembles the changelogs that liquibase runs before the app is deployed: this service's own
# master changelog, and the tenant-lifecycle changelog that ships inside the spring-boot-tenancy library.

# This script does all its staging in a directory called target for easy cleanup and effective .gitignore.
docker_context_dir=ci/predeploy/target
rm -rf ${docker_context_dir}
mkdir -p ${docker_context_dir}
# Allows us to pass settings.xml configured on local machine or CI server to access private Maven repositories
mkdir -p ${docker_context_dir}/.m2
cp -rp .mvn mvnw pom.xml ${docker_context_dir}
cp ~/.m2/*.xml ${docker_context_dir}/.m2
cp src/main/resources/db/changelog/db.changelog-master.yaml ${docker_context_dir}/db.changelog-master.yaml

(cd ci/predeploy && docker build -t ${target_image_name} .)
